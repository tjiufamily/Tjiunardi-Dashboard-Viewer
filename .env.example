# Optional: storage bucket overrides for company file links on Entry Pricing.
# Use these when `companies.fastgraph_object_key` and `companies.financial_object_key`
# store object paths (e.g. `companies/tmp/fastgraph/...`) without bucket prefix.
# If both file types live in one bucket, set only VITE_SUPABASE_STORAGE_BUCKET.
# VITE_SUPABASE_STORAGE_BUCKET=your_bucket_name
# VITE_SUPABASE_FASTGRAPH_BUCKET=your_fastgraph_bucket
# VITE_SUPABASE_FINANCIAL_BUCKET=your_financial_bucket

# Optional: delayed quotes via Finnhub (free tier). Without it, the app tries Stooq (no key; may be blocked by CORS in some browsers).
# VITE_FINNHUB_API_KEY=
# Optional: non-Finnhub quote concurrency (used when Finnhub key is absent). Range 1-8, default 4.
# VITE_QUOTE_CONCURRENCY=4

# Optional Supabase column on `companies`: `quote_ticker` (text) — Finnhub symbol for quotes when `ticker` alone fails (e.g. SAP.DE, BP.L).

# Optional: Gemini backup when Finnhub + Stooq return no price (Google AI Studio API key). Verify model-assisted prices.
# VITE_GEMINI_API_KEY=
# Optional model id (default: gemini-2.0-flash)
# VITE_GEMINI_MODEL=gemini-2.0-flash