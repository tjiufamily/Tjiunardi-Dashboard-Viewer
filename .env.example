VITE_SUPABASE_ANON_KEY=sb_publishable_4ffk40tShWa4AMhLJ0RTuQ_tcqUaIC1

# Optional: storage bucket overrides for company file links on Entry Pricing.
# Use these when `companies.fastgraph_object_key` and `companies.financial_object_key`
# store object paths (e.g. `companies/tmp/fastgraph/...`) without bucket prefix.
# If both file types live in one bucket, set only VITE_SUPABASE_STORAGE_BUCKET.
# VITE_SUPABASE_STORAGE_BUCKET=your_bucket_name
# VITE_SUPABASE_FASTGRAPH_BUCKET=your_fastgraph_bucket
# VITE_SUPABASE_FINANCIAL_BUCKET=your_financial_bucket

# Optional: delayed quotes via Finnhub (free tier). Without it, the app tries Stooq (no key; may be blocked by CORS in some browsers).
# VITE_FINNHUB_API_KEY=
# Optional: non-Finnhub quote concurrency (used when Finnhub key is absent). Range 1-8, default 4.
# VITE_QUOTE_CONCURRENCY=4
# Optional: concurrent AI quote fallback workers. Range 1-8, default 4.
# VITE_AI_QUOTE_CONCURRENCY=4

# Optional Supabase column on `companies`: `quote_ticker` (text) — Finnhub symbol for quotes when `ticker` alone fails (e.g. SAP.DE, BP.L).

# Primary AI quote fallback: OpenCode Go subscription key (DeepSeek V4 Flash recommended).
# Subscribe at https://opencode.ai — then paste your Go API key here.
# VITE_OPENCODE_GO_API_KEY=
# Optional model id (default: deepseek-v4-flash)
# VITE_OPENCODE_GO_MODEL=deepseek-v4-flash
# Optional API base (default: /api/opencode-go proxy). Only change for custom proxies.
# VITE_OPENCODE_GO_API_URL=/api/opencode-go
# For Vercel deploy, also set server-side OPENCODE_GO_API_KEY (same value) so the /api proxy works.

# Optional: Gemini backup when OpenCode Go + web sources return no price (Google AI Studio API key).
# VITE_GEMINI_API_KEY=
# Optional model id (default: gemini-2.0-flash)
# VITE_GEMINI_MODEL=gemini-2.0-flash

# Local dev only: folder with batch-exported PDF reports (npm run dev).
# Defaults to your OneDrive Reports folder if unset.
# REPORTS_DIR=C:\Users\tjiun\OneDrive\Documents\Tjiunardi Stock Research Gemini Dashboard\Reports